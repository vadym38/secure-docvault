# Скопіюйте цей файл у .env і замініть SECRET_KEY та JWT_SECRET_KEY
# на випадкові значення. Згенерувати ключ:
# python -c "import secrets; print(secrets.token_hex(32))"

SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-another-64-char-random-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_LEEWAY_SECONDS=5
DOCVAULT_DB=instance/docvault.db
BCRYPT_ROUNDS=12
# У демонстраційному HTTPS-режимі встановіть 1, щоб cookie мала прапорець Secure.
SESSION_COOKIE_SECURE=0
# Явний whitelist Origin для CORS. Wildcard '*' не підтримується.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000,https://127.0.0.1:5000,https://localhost:5000
# Максимальна довжина текстових полів лабораторії санітизації.
CLIENT_LAB_MAX_TEXT=2000

# --- WAF / Rate Limiting (ЛР №4) -----------------------------------------
WAF_ENABLED=1
RATE_LIMIT_ENABLED=1
RATE_LIMIT_LOGIN_LIMIT=5
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_API_LIMIT=60
RATE_LIMIT_API_WINDOW=60
RATE_LIMIT_WEB_LIMIT=120
RATE_LIMIT_WEB_WINDOW=60
RATE_LIMIT_MAX_KEYS=10000
RATE_LIMIT_KEY_TTL_SECONDS=600
WAF_GREYLIST_SECONDS=300
WAF_MAX_BODY_INSPECT=65536
SECURITY_LOG_CAPACITY=200
# Довіряти X-Forwarded-For можна лише за довіреним reverse-proxy.
TRUST_PROXY_HEADERS=0
# Лабораторний Reset на /waf-lab. У production встановіть 0.
WAF_LAB_ALLOW_RESET=1

# --- Шифрування файлів (ЛР №5) -------------------------------------------
# 32-байтний AES-256 ключ у hex (64 символи). Згенерувати:
# python -c "import secrets; print(secrets.token_hex(32))"
FILE_ENCRYPTION_KEY=replace-with-64-hex-chars
# Старі ключі для ротації (через кому), якщо потрібно читати старі файли.
FILE_ENCRYPTION_KEY_OLD=
# У production встановіть 1: старт без ключа буде помилкою.
FILE_ENCRYPTION_KEY_REQUIRED=0
DOCUMENT_STORAGE_DIR=instance/vault
MAX_DOCUMENT_BYTES=5242880
ALLOWED_DOCUMENT_EXTENSIONS=pdf,txt,md,csv,json,docx,doc,xlsx,xls,pptx,ppt,png,jpg,jpeg,gif,zip

FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
