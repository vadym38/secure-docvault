# Скопіюйте цей файл у .env і замініть SECRET_KEY на випадкове значення.
# Згенерувати ключ: python -c "import secrets; print(secrets.token_hex(32))"

SECRET_KEY=replace-with-a-long-random-secret
DOCVAULT_DB=instance/docvault.db
BCRYPT_ROUNDS=12
SESSION_COOKIE_SECURE=0
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
